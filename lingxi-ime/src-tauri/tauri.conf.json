{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灵犀输入法",
  "version": "0.1.0",
  "identifier": "com.lingxi.ime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "灵犀输入法设置",
        "label": "main",
        "width": 880,
        "height": 640,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "focus": true,
        "focusable": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "rime/rime.dll": "rime/rime.dll",
      "rime/rime_dict_manager.exe": "rime/rime_dict_manager.exe",
      "rime/data/**/*": "rime/data/"
    }
  }
}
